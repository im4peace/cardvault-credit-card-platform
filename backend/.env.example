# Copy to .env (git-ignored). Values below are DEMO-ONLY placeholders - never commit real secrets.
DATABASE_URL="file:./dev.db"
# Demo-only value. In production the server refuses to start unless JWT_SECRET is a strong (32+ char) non-demo secret.
JWT_SECRET="demo-only-secret-change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
MAX_APPROVED_LIMIT=100000
# TRUST_PROXY=1   # number of reverse-proxy hops; only when running behind a proxy
