{
  "name": "credit-card-management",
  "description": "Demo credit card application and management web app (simulated data only).",
  "stack": {
    "backend": {
      "language": "typescript",
      "runtime": "node",
      "framework": "express",
      "package_manager": "npm",
      "linter": "eslint",
      "typechecker": "tsc",
      "test_runner": "vitest",
      "orm": "prisma"
    },
    "frontend": {
      "language": "typescript",
      "framework": "react",
      "bundler": "vite",
      "router": "react-router",
      "package_manager": "npm",
      "linter": "eslint",
      "typechecker": "tsc",
      "test_runner": "vitest",
      "testing_library": "react-testing-library"
    },
    "database": {
      "primary": "sqlite",
      "secondary": null
    },
    "deployment": {
      "method": "local",
      "services": [
        "backend",
        "frontend"
      ]
    }
  },
  "evaluation": {
    "api_base_url": "http://localhost:4000",
    "ui_base_url": "http://localhost:5173",
    "health_check": "/health",
    "design_score_threshold": 7,
    "design_max_iterations": 10,
    "test_corpus_dir": "specs/test_artefacts"
  },
  "execution": {
    "default_mode": "full",
    "max_self_heal_attempts": 3,
    "max_auto_iterations": 50,
    "coverage_threshold": 80,
    "session_chaining": true,
    "agent_team_size": "auto",
    "teammate_model": "sonnet"
  },
  "verification": {
    "mode": "local",
    "health_check": {
      "url": "http://localhost:4000/health",
      "retries": 5,
      "backoff_seconds": 2
    },
    "local": {
      "backend_url": "http://localhost:4000",
      "frontend_url": "http://localhost:5173",
      "start_commands": [
        "cd backend && npm run dev",
        "cd frontend && npm run dev"
      ]
    }
  }
}
